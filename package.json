{
	"name": "Denovitan",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "deno run -A scripts/dev.ts",
		"dev:backend": "deno run --allow-all backend/main.ts",
		"dev:backend-inspect": "deno run --inspect-brk --allow-all --inspect=127.0.0.1:9230 backend/main.ts",
		"dev:frontend": "deno run -A npm:vite",
		"dev:app": "deno run --allow-all app/shell.ts",
		"dev:app-inspect": "deno run --inspect-brk --allow-all --inspect=127.0.0.1:9231 app/shell.ts",
		"build": "vite build",
		"lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
		"preview": "vite preview",
		"test": "deno test --allow-all",
		"test:debug": "deno test --inspect-brk --allow-all --inspect=127.0.0.1:9230",
		"grue:vscode:debug": "bash ./scripts/test_vscode_debug.sh",
		"grue:success": "curl -s http://localhost:22222/YES -o /dev/null 2>&1",
		"grue:fail": "curl -s http://localhost:22222/NO -o /dev/null 2>&1"
	},
	"dependencies": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-router-dom": "^6.26.2"
	},
	"devDependencies": {
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@typescript-eslint/eslint-plugin": "^7.15.0",
		"@typescript-eslint/parser": "^7.15.0",
		"@vitejs/plugin-react": "^4.3.1",
		"eslint": "^8.57.0",
		"eslint-plugin-react-hooks": "^4.6.2",
		"eslint-plugin-react-refresh": "^0.4.7",
		"typescript": "^5.2.2",
		"vite": "^5.3.4"
	}
}
